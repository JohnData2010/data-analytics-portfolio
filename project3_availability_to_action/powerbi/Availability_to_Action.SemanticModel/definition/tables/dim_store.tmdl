/// 898 stores (encoded ids)
table dim_store
	lineageTag: 78743db2-31d3-6320-1609-507c23837b7a

	column store_id
		dataType: double
		lineageTag: 3cd140c1-5b71-445c-df56-413c19bb3451
		summarizeBy: none
		sourceColumn: store_id

		annotation SummarizationSetBy = User

	column city_id
		dataType: double
		lineageTag: b525d3dc-9bf2-8aad-3ed1-5c74eaea6002
		summarizeBy: none
		sourceColumn: city_id

		annotation SummarizationSetBy = User

	column series
		dataType: int64
		formatString: 0
		lineageTag: 59477570-f1d3-cb7e-ba0e-28aa01b322bb
		summarizeBy: none
		sourceColumn: series

		annotation SummarizationSetBy = User

	partition dim_store = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "\dim_store.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Typed = Table.TransformColumnTypes(Promoted, {{"store_id", type number}, {"city_id", type number}, {"series", Int64.Type}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table
