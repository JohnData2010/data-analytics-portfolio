/// Holdout-week review list: top 25 per store, scored on day 91
table decision_list
	lineageTag: c0092bc9-ed11-dfb4-478f-715a97ade214

	measure 'Listed series' = CALCULATE ( COUNTROWS ( decision_list ), decision_list[in_store_top_n] = TRUE () )
		formatString: #,0
		displayFolder: Review list
		lineageTag: 55f48708-b407-ac47-231d-d8e5e86f595a

	measure 'Expected lost demand, listed (7 days)' = CALCULATE ( SUM ( decision_list[expected_lost_7d] ), decision_list[in_store_top_n] = TRUE () )
		formatString: #,0.0
		displayFolder: Review list
		lineageTag: 69927d19-8b80-930f-433b-5ed176b5f674

	measure 'Realised lost demand, listed' = CALCULATE ( SUM ( decision_list[outcome_lost] ), decision_list[in_store_top_n] = TRUE () )
		formatString: #,0.0
		displayFolder: Review list
		lineageTag: e35f9a23-cc46-a4c1-9a40-f831ed316e95

	measure 'Realised vs expected' = DIVIDE ( [Realised lost demand, listed], [Expected lost demand, listed (7 days)] )
		formatString: 0.0%
		displayFolder: Review list
		lineageTag: 67315b41-6f25-61cf-9e80-9db942977033

	measure 'Low-confidence listed' = CALCULATE ( COUNTROWS ( decision_list ), decision_list[in_store_top_n] = TRUE (), decision_list[confidence] = "Low" ) + 0
		formatString: #,0
		displayFolder: Review list
		lineageTag: bf4197fe-ea27-c278-53a5-db7a50a1834b

