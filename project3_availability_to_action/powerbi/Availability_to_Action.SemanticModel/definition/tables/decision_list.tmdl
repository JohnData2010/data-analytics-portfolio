	partition decision_list = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "\decision_list.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Typed = Table.TransformColumnTypes(Promoted, {{"series_id", type number}, {"store_id", type number}, {"city_id", type number}, {"product_id", type number}, {"first_category_id", type number}, {"second_category_id", type number}, {"third_category_id", type number}, {"store_rank", Int64.Type}, {"global_rank", Int64.Type}, {"in_store_top_n", type logical}, {"expected_lost_7d", type number}, {"obs_28", type number}, {"rec_28", type number}, {"lost_28", type number}, {"imputed_share", type number}, {"hidden_vs_recorded", type number}, {"oos_days_28", Int64.Type}, {"oos_days_7", Int64.Type}, {"oos_hours_28", Int64.Type}, {"unavailable_days_28", Int64.Type}, {"conflict_days_28", Int64.Type}, {"instock_days", Int64.Type}, {"typical_sellout_hour", type number}, {"confidence", type text}, {"reasons", type text}, {"checks_before_acting", type text}, {"outcome_lost", type number}, {"outcome_oos_hours", Int64.Type}, {"outcome_unavailable_days", Int64.Type}, {"outcome_recorded", type number}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table

