	partition dim_series = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "\dim_series.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Typed = Table.TransformColumnTypes(Promoted, {{"series_id", type number}, {"store_id", type number}, {"product_id", type number}, {"city_id", type number}, {"management_group_id", type number}, {"first_category_id", type number}, {"second_category_id", type number}, {"third_category_id", type number}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table
