	partition gov_source_manifest = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "\gov_source_manifest.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Typed = Table.TransformColumnTypes(Promoted, {{"split", type text}, {"file", type text}, {"sha256", type text}, {"bytes", Int64.Type}, {"rows", Int64.Type}, {"series", Int64.Type}, {"first_date", type datetime}, {"last_date", type datetime}, {"publisher", type text}, {"licence", type text}, {"source_url", type text}, {"file_downloaded", type text}}, "en-US"),
				    Dated = Table.TransformColumnTypes(Typed, {{"first_date", type date}, {"last_date", type date}})
				in
				    Dated

