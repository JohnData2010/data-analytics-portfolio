table fact_store_day
	lineageTag: edab36d4-add2-e7f6-3859-9f362af96fe5

	measure 'Store recorded sales' = SUM ( fact_store_day[recorded] )
		formatString: #,0.0
		displayFolder: Store
		lineageTag: 7a23ef93-9b3b-e396-1c55-6dcd57d619b1

	measure 'Store recovered demand' = SUM ( fact_store_day[recovered] )
		formatString: #,0.0
		displayFolder: Store
		lineageTag: ec7e7659-4c41-db91-6cd4-674eeff4e410

	measure 'Hidden demand vs recorded' = DIVIDE ( SUM ( fact_store_day[lost_partial] ), SUM ( fact_store_day[recorded] ) )
		formatString: 0.0%
		displayFolder: Store
		lineageTag: b053bbb7-5040-b3f9-1414-82776be68ee7

	measure 'Series-days with a stockout' = DIVIDE ( SUM ( fact_store_day[series_days_with_stockout] ), SUM ( fact_store_day[series] ) )
		formatString: 0.0%
		displayFolder: Store
		lineageTag: 541f264a-b214-b4e7-ab65-9b00f2da1f96

	measure 'Unavailable series-days' = SUM ( fact_store_day[unavailable_series_days] )
		formatString: #,0
		displayFolder: Store
		lineageTag: 391b5a4b-f7e3-f2d9-a517-2deb3a42da3b

