	partition fact_store_day = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "\fact_store_day.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Typed = Table.TransformColumnTypes(Promoted, {{"day_idx", Int64.Type}, {"dt", type datetime}, {"store_id", type number}, {"is_outcome", type logical}, {"series", Int64.Type}, {"recorded", type number}, {"recovered", type number}, {"lost_partial", type number}, {"unavailable_series_days", Int64.Type}, {"oos_hours", Int64.Type}, {"series_days_with_stockout", Int64.Type}}, "en-US"),
				    Dated = Table.TransformColumnTypes(Typed, {{"dt", type date}})
				in
				    Dated

	annotation PBI_ResultType = Table
