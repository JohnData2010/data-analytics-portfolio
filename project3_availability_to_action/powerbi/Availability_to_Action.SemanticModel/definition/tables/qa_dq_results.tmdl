	partition qa_dq_results = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "\qa_dq_results.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Typed = Table.TransformColumnTypes(Promoted, {{"rule_id", type text}, {"check", type text}, {"severity", type text}, {"rows_checked", Int64.Type}, {"rows_flagged", Int64.Type}, {"rate", type number}, {"decision_impact", type text}, {"treatment", type text}, {"status", type text}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table

