table qa_dq_results
	lineageTag: 7c89369f-de83-5909-76f5-358b4e369fb4

	measure 'DQ checks passed' = CALCULATE ( COUNTROWS ( qa_dq_results ), qa_dq_results[status] = "PASS" ) + 0
		formatString: #,0
		displayFolder: Data quality
		lineageTag: eef389af-27db-7849-3e52-5112c453ce75

	measure 'DQ checks warned' = CALCULATE ( COUNTROWS ( qa_dq_results ), qa_dq_results[status] = "WARN" ) + 0
		formatString: #,0
		displayFolder: Data quality
		lineageTag: 13c73934-8330-5cc6-7808-a32ea5ece901

	measure 'DQ checks failed' = CALCULATE ( COUNTROWS ( qa_dq_results ), qa_dq_results[status] = "FAIL" ) + 0
		formatString: #,0
		displayFolder: Data quality
		lineageTag: a28084fa-fcf1-1c02-ddab-6680fe6e586d

	column rule_id
