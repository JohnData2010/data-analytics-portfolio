	partition kpi_summary = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "\kpi_summary.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Typed = Table.TransformColumnTypes(Promoted, {{"dataset", type text}, {"service_group", type text}, {"requests", Int64.Type}, {"closed", Int64.Type}, {"open", Int64.Type}, {"k01_median_days", type number}, {"k02_p90_days", type number}, {"k04_open_median_age", type number}, {"k04_open_share_over_90d", type number}, {"k05_open_share", type number}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table

