table kpi_summary
	lineageTag: 4175d0b8-5d30-7a5b-d07d-20405f5ab70d

	measure 'Total requests' = IF ( HASONEVALUE ( dim_dataset[dataset] ), CALCULATE ( SUM ( kpi_summary[requests] ), kpi_summary[service_group] = "(all)" ), BLANK () )
		formatString: #,0
		displayFolder: Service performance
		lineageTag: 954185a4-66f8-9b0f-b0a2-40017a9afe7a

	measure 'Open requests' = IF ( HASONEVALUE ( dim_dataset[dataset] ), CALCULATE ( SUM ( kpi_summary[open] ), kpi_summary[service_group] = "(all)" ), BLANK () )
		formatString: #,0
		displayFolder: Service performance
		lineageTag: 564782e8-879c-9b7f-05dd-8adaea5f7204

	measure 'Open share' = IF ( HASONEVALUE ( dim_dataset[dataset] ), CALCULATE ( MAX ( kpi_summary[k05_open_share] ), kpi_summary[service_group] = "(all)" ), BLANK () )
		formatString: 0.0%
		displayFolder: Service performance
		lineageTag: b20e3583-8cbe-de80-8141-f8daa759eea7

	measure 'Median days (closed only)' = IF ( HASONEVALUE ( dim_dataset[dataset] ), CALCULATE ( MAX ( kpi_summary[k01_median_days] ), kpi_summary[service_group] = "(all)" ), BLANK () )
		formatString: 0.0
		displayFolder: Service performance
		lineageTag: cea46703-c5f3-dc3d-034a-61f51a1f6c74

	measure 'P90 days (closed only)' = IF ( HASONEVALUE ( dim_dataset[dataset] ), CALCULATE ( MAX ( kpi_summary[k02_p90_days] ), kpi_summary[service_group] = "(all)" ), BLANK () )
		formatString: 0.0
		displayFolder: Service performance
		lineageTag: ca271078-bc62-ae44-6e2e-faf287a28058

	measure 'Open median age (days)' = IF ( HASONEVALUE ( dim_dataset[dataset] ), CALCULATE ( MAX ( kpi_summary[k04_open_median_age] ), kpi_summary[service_group] = "(all)" ), BLANK () )
		formatString: 0.0
		displayFolder: Service performance
		lineageTag: 0fbcfed0-4845-9131-a308-c14f802b919c

