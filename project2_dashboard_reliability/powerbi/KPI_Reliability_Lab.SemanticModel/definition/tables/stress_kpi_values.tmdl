	partition stress_kpi_values = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "\stress_kpi_values.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Typed = Table.TransformColumnTypes(Promoted, {{"dataset", type text}, {"service_group", type text}, {"requests", Int64.Type}, {"kpi", type text}, {"kpi_label", type text}, {"value", type number}, {"higher_is_better", type logical}, {"rank", type number}, {"groups_ranked", Int64.Type}}, "en-US")
				in
