				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Typed = Table.TransformColumnTypes(Promoted, {{"dataset", type text}, {"service_group", type text}, {"intake_month", type datetime}, {"received", Int64.Type}, {"closed_within_30", Int64.Type}, {"k03_closure_30d", type number}, {"followup_days_after_cohort_end", Int64.Type}, {"full_window", type logical}}, "en-US"),
