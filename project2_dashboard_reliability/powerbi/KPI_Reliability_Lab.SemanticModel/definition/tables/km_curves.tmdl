	partition km_curves = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "\km_curves.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Typed = Table.TransformColumnTypes(Promoted, {{"t", type number}, {"survival", type number}, {"at_risk", Int64.Type}, {"dataset", type text}, {"service_group", type text}, {"share_closed", type number}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table

