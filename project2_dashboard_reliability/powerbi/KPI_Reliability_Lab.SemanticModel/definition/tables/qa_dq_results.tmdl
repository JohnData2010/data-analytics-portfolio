	partition qa_dq_results = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "\qa_dq_results.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Typed = Table.TransformColumnTypes(Promoted, {{"rule_id", type text}, {"dataset", type text}, {"check", type text}, {"severity", type text}, {"rows_flagged", Int64.Type}, {"rate", type number}, {"kpis_touched", type text}, {"kpi_impact_if_excluded", type text}, {"status", type text}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table

