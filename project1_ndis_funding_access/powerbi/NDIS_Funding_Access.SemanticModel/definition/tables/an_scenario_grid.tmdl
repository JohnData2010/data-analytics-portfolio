	partition an_scenario_grid = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "\an_scenario_grid.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Typed = Table.TransformColumnTypes(Promoted, {{"district_key", type text}, {"state", type text}, {"district", type text}, {"denominator_date", type datetime}, {"denominator_eligible_total", Int64.Type}, {"baseline_not_using", Int64.Type}, {"baseline_share", type number}, {"reduction_pts", Int64.Type}, {"scenario_share", type number}, {"scenario_not_using", type number}, {"participants_moving_to_use", type number}, {"assumption", type text}}, "en-US"),
