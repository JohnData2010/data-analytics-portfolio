	partition fact_util_standardised = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "\fact_util_standardised.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Typed = Table.TransformColumnTypes(Promoted, {{"report_date", type datetime}, {"state", type text}, {"district", type text}, {"district_key", type text}, {"expected_rate", type number}, {"within_cell_gap", type number}, {"within_cell_coverage", type number}, {"weight_share_estimated", type number}, {"observed_rate", type number}, {"active_participants", Int64.Type}, {"national_rate", type number}, {"mix_effect", type number}, {"like_for_like_gap", type number}, {"raw_gap", type number}}, "en-US"),
				    Dated = Table.TransformColumnTypes(Typed, {{"report_date", type date}})
				in
				    Dated

	annotation PBI_ResultType = Table

