	partition an_evidence_register = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "\an_evidence_register.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Typed = Table.TransformColumnTypes(Promoted, {{"claim_id", type text}, {"module", type text}, {"scope", type text}, {"topic", type text}, {"claim", type text}, {"status", type text}, {"rule", type text}, {"evidence", type text}, {"caveats", type text}, {"information_needed", type text}}, "en-US")
				in
