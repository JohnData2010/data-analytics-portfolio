table qa_reconciliation
	lineageTag: 8f2a48a9-a990-eb81-ec07-b20327dc45be

	measure 'Checks passed' = CALCULATE ( COUNTROWS ( qa_reconciliation ), qa_reconciliation[status] = "PASS" ) + 0
		formatString: #,0
		displayFolder: QA
		lineageTag: 98ba1450-7a8d-ec4a-14f8-49094dab1d66

	measure 'Checks warned' = CALCULATE ( COUNTROWS ( qa_reconciliation ), qa_reconciliation[status] = "WARN" ) + 0
		formatString: #,0
		displayFolder: QA
		lineageTag: f660fe0b-d7c0-34d9-7b83-4a4c525a2875

	measure 'Checks failed' = CALCULATE ( COUNTROWS ( qa_reconciliation ), qa_reconciliation[status] = "FAIL" ) + 0
		formatString: #,0
		displayFolder: QA
		lineageTag: 357964fc-1305-49f6-0776-1977bf411ea5

