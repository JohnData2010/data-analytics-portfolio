	partition qa_reconciliation = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "\qa_reconciliation.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Typed = Table.TransformColumnTypes(Promoted, {{"check_id", type text}, {"kind", type text}, {"description", type text}, {"expected", Int64.Type}, {"actual", Int64.Type}, {"difference", Int64.Type}, {"tolerance", Int64.Type}, {"status", type text}, {"note", type text}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table

