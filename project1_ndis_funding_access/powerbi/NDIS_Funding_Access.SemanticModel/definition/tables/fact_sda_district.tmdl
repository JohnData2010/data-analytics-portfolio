	partition fact_sda_district = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "\fact_sda_district.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Typed = Table.TransformColumnTypes(Promoted, {{"report_date", type datetime}, {"state", type text}, {"district", type text}, {"in_use", Int64.Type}, {"in_use_masked", type logical}, {"in_use_upper", Int64.Type}, {"not_using", Int64.Type}, {"not_using_masked", type logical}, {"not_using_upper", Int64.Type}, {"district_key", type text}, {"any_masked", type logical}, {"eligible_total", Int64.Type}, {"non_use_share", type number}, {"non_use_share_min", type number}, {"non_use_share_max", type number}, {"active_participants", Int64.Type}, {"active_participants_source", type text}, {"not_using_per_1000_active", type number}, {"national_non_use_share", type number}, {"national_not_using", Int64.Type}, {"national_eligible", Int64.Type}}, "en-US"),
				    Dated = Table.TransformColumnTypes(Typed, {{"report_date", type date}})
				in
				    Dated

	annotation PBI_ResultType = Table

