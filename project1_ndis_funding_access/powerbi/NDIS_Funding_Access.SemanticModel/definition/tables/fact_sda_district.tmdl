table fact_sda_district
	lineageTag: 4925d0a4-8e73-66cc-238f-f1f340fba7e3

	measure 'SDA in use' = SUM ( fact_sda_district[in_use] )
		formatString: #,0
		displayFolder: Module B
		lineageTag: 7c6ab540-45ea-8e3a-0eef-e520029e7d79

	measure 'SDA eligible not using' = SUM ( fact_sda_district[not_using] )
		formatString: #,0
		displayFolder: Module B
		lineageTag: 7808f97b-ef3d-5532-a8c7-6c5e6e31ffcb

	measure 'SDA eligible total' = SUM ( fact_sda_district[eligible_total] )
		formatString: #,0
		displayFolder: Module B
		lineageTag: ba9168ed-6744-11df-d28c-e8c3aea5a35a

	measure 'Non-use share %' = DIVIDE ( [SDA eligible not using], [SDA eligible total] )
		formatString: 0.0%
		displayFolder: Module B
		lineageTag: 86e6f35e-800f-2001-8caf-0ede30bac173

	measure 'National non-use share %' = AVERAGE ( fact_sda_district[national_non_use_share] )
		formatString: 0.0%
		displayFolder: Module B
		lineageTag: b7bf399c-c922-88e5-f68c-3c3cd63f87f3

	measure 'Masked cells in view' = CALCULATE ( COUNTROWS ( fact_sda_district ), fact_sda_district[any_masked] = TRUE () ) + 0
		formatString: #,0
		displayFolder: Module B
		lineageTag: dc98a75c-ee99-0f78-7e69-6a6636103189

	measure 'Latest national not using' =
			VAR d = CALCULATE ( MAX ( fact_sda_district[report_date] ), ALL ( fact_sda_district ) )
			RETURN CALCULATE ( MAX ( fact_sda_district[national_not_using] ), ALL ( fact_sda_district ),
			    fact_sda_district[report_date] = d )
		formatString: #,0
		displayFolder: Module B
		lineageTag: 820b1e29-6e36-764b-0ee6-5822657cf734

	measure 'Latest national non-use share %' =
			VAR d = CALCULATE ( MAX ( fact_sda_district[report_date] ), ALL ( fact_sda_district ) )
			RETURN CALCULATE ( MAX ( fact_sda_district[national_non_use_share] ), ALL ( fact_sda_district ),
			    fact_sda_district[report_date] = d )
		formatString: 0.0%
		displayFolder: Module B
		lineageTag: 969d0cae-a05d-d628-5eaa-2813c5f36d6e

