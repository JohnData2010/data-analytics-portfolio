	measure 'Districts persistently above national' = CALCULATE ( COUNTROWS ( an_sda_persistence ), an_sda_persistence[persistent_above_national] = TRUE () ) + 0
		formatString: #,0
		displayFolder: Module B
		lineageTag: d527e985-6990-0e93-33b6-2e0752b521b9

