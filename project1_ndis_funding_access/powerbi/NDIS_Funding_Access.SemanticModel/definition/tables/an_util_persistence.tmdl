table an_util_persistence
	lineageTag: 121c2b46-603c-9a4a-f83e-a509f7c8abdc

	measure 'Districts persistently low (raw)' = CALCULATE ( COUNTROWS ( an_util_persistence ), an_util_persistence[persistent_low_raw] = TRUE () ) + 0
		formatString: #,0
		displayFolder: Module A
		lineageTag: ccedce73-5ffc-4ac5-a5c5-87759553dada

	measure 'Districts persistently low (like-for-like)' = CALCULATE ( COUNTROWS ( an_util_persistence ), an_util_persistence[persistent_low_adjusted] = TRUE () ) + 0
		formatString: #,0
		displayFolder: Module A
		lineageTag: 4a98dc8d-32bc-ea5f-f2ed-69abe58d8d8f

	measure 'Low mostly explained by mix' = CALCULATE ( COUNTROWS ( an_util_persistence ), an_util_persistence[low_mostly_mix] = TRUE () ) + 0
		formatString: #,0
		displayFolder: Module A
		lineageTag: f6e6077f-5797-d185-825a-beb5c4acacc7

	measure 'Mean like-for-like gap (pts)' = AVERAGE ( an_util_persistence[mean_like_for_like_gap] ) * 100
		formatString: +0.0;-0.0;0.0
		displayFolder: Module A
		lineageTag: b58685bb-1871-3164-92c8-b727b024bb1c

