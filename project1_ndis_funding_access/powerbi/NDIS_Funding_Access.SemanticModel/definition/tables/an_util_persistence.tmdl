				    Typed = Table.TransformColumnTypes(Promoted, {{"district_key", type text}, {"state", type text}, {"district", type text}, {"quarters_observed", Int64.Type}, {"quarters_bottom_quintile_raw", Int64.Type}, {"quarters_bottom_quintile_adjusted", Int64.Type}, {"mean_observed_rate", type number}, {"mean_raw_gap", type number}, {"mean_mix_effect", type number}, {"mean_like_for_like_gap", type number}, {"mean_within_cell_gap", type number}, {"mean_within_cell_coverage", type number}, {"trend_pts_per_quarter", type number}, {"latest_observed_rate", type number}, {"latest_like_for_like_gap", type number}, {"latest_active_participants", Int64.Type}, {"persistent_low_raw", type logical}, {"persistent_low_adjusted", type logical}, {"low_mostly_mix", type logical}}, "en-US")
				in
